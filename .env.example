# Copy to .env next to package.json, or to ~/.config/free-llm-gateway/.env (chmod 600). Never commit the real file.
# Required: the one key every client uses (at least 16 characters).  openssl rand -hex 24
GATEWAY_KEY=
GATEWAY_PORT=8787
# GATEWAY_HOST=127.0.0.1   # 0.0.0.0 to listen on the network

# ---- free tiers: fill the ones you have, leave the rest empty (they are skipped).
# How to get each key: README, "Cara mendapatkan API key" / "Getting the API keys"
GROQ_API_KEY=            # console.groq.com/keys
GEMINI_API_KEY=          # aistudio.google.com/apikey
OPENROUTER_API_KEY=      # openrouter.ai/settings/keys (":free" models only)
NVIDIA_API_KEY=          # build.nvidia.com
CLOUDFLARE_ACCOUNT_ID=   # dash.cloudflare.com -> AI -> Workers AI
CLOUDFLARE_AI_TOKEN=
CEREBRAS_API_KEY=        # cloud.cerebras.ai
MISTRAL_API_KEY=         # optional: Mistral seems to have ended its free API in late 2026

# ---- optional
# GATEWAY_REFERER=https://example.com   # sent to OpenRouter as HTTP-Referer
# TRUST_CF_ACCESS=1                     # only behind Cloudflare Access: open /status to logged-in users
